#
# Privasimu Nexus — On-Prem AI Stack
# .env.example
#
# ⚠️  JANGAN edit file ini langsung untuk deploy.
#     Pilih profile via:
#
#         bash scripts/switch-profile.sh qwen3-32b       # stable / production
#         bash scripts/switch-profile.sh qwen3.6-27b     # pilot / next-gen
#
# Script akan copy profile terpilih dari .env.profiles/ ke .env.
#
# File ini cuma reference lengkap semua variable yang supported.
# Untuk config aktual, edit file di .env.profiles/.
#

# ==============================================================================
# Active Profile Selector
# ==============================================================================
# Set via switch-profile.sh — jangan edit manual
PROFILE_NAME=qwen3-32b
PROFILE_DESC=Stable production profile
PROFILE_TIER=production

# Compose profiles (kosongin untuk main-only, atau "vlm-fallback" untuk aktifkan VLM service)
COMPOSE_PROFILES=vlm-fallback

# ==============================================================================
# Docker Images
# ==============================================================================
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.5
OCR_IMAGE=paddlecloud/paddleocr-gpu:2.7.0

# ==============================================================================
# Directories
# ==============================================================================
MODELS_DIR=/opt/privasimu/models
TLS_DIR=/opt/privasimu/tls

# ==============================================================================
# GPU Assignment
# ==============================================================================
VLLM_GPU_ID=0
VLM_GPU_ID=0
TEI_GPU_ID=0
OCR_GPU_ID=0

# ==============================================================================
# Primary LLM
# ==============================================================================
LLM_MODEL_DIR=Qwen3-32B-AWQ
LLM_SERVED_NAME=qwen3-32b
LLM_TP_SIZE=1
LLM_MAX_CONTEXT=32768
LLM_GPU_MEM_UTIL=0.65
LLM_QUANTIZATION=awq

# ==============================================================================
# VLM Fallback (hanya profile qwen3-32b)
# ==============================================================================
VLM_MODEL_DIR=Qwen2.5-VL-7B-Instruct
VLM_SERVED_NAME=qwen2.5-vl
VLM_MAX_CONTEXT=16384
VLM_GPU_MEM_UTIL=0.20
VLM_QUANTIZATION=

# ==============================================================================
# Embedding + OCR + Gateway
# ==============================================================================
EMBED_MODEL_DIR=bge-m3
OCR_LANG=en
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
PROMETHEUS_PORT=9090
METRICS_RETENTION=30d
