#
# Profile: QWEN3-32B (Stable / Default)
# ────────────────────────────────────────────────────────────────────────
# Stack: Qwen3-32B AWQ Q4 (chat) + Qwen2.5-VL-7B (vision fallback) +
#        bge-m3 (embeddings) + PaddleOCR + NGINX + Prometheus
#
# Use case: 5 deal klien enterprise yang sudah committed. Battle-tested,
#           tool calling mature, AWQ quant widely available.
# Target GPU: L40S 48GB atau H100 80GB (single GPU OK).
#

# Activate optional Qwen2.5-VL fallback service via compose profile
COMPOSE_PROFILES=vlm-fallback

# ==============================================================================
# Docker Images (pinned)
# ==============================================================================
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.5
OCR_IMAGE=paddlecloud/paddleocr-gpu:2.7.0

# ==============================================================================
# Directories
# ==============================================================================
MODELS_DIR=/opt/privasimu/models
TLS_DIR=/opt/privasimu/tls

# ==============================================================================
# GPU Assignment
# ==============================================================================
VLLM_GPU_ID=0
VLM_GPU_ID=0
TEI_GPU_ID=0
OCR_GPU_ID=0

# ==============================================================================
# Primary LLM — Qwen3-32B AWQ
# ==============================================================================
LLM_MODEL_DIR=Qwen3-32B-AWQ
LLM_SERVED_NAME=qwen3-32b
LLM_TP_SIZE=1
LLM_MAX_CONTEXT=32768
LLM_GPU_MEM_UTIL=0.65          # reserve room untuk VLM fallback + embeddings
LLM_QUANTIZATION=awq

# ==============================================================================
# VLM Fallback — Qwen2.5-VL-7B
# Only active in this profile (COMPOSE_PROFILES=vlm-fallback)
# ==============================================================================
VLM_MODEL_DIR=Qwen2.5-VL-7B-Instruct
VLM_SERVED_NAME=qwen2.5-vl
VLM_GPU_MEM_UTIL=0.20
VLM_MAX_CONTEXT=16384
VLM_QUANTIZATION=              # FP16 untuk 7B — muat di sisa VRAM

# ==============================================================================
# Embedding
# ==============================================================================
EMBED_MODEL_DIR=bge-m3

# ==============================================================================
# OCR
# ==============================================================================
OCR_LANG=en

# ==============================================================================
# Gateway
# ==============================================================================
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
PROMETHEUS_PORT=9090
METRICS_RETENTION=30d

# ==============================================================================
# Profile metadata (referenced by switch-profile.sh dan status.sh)
# ==============================================================================
PROFILE_NAME=qwen3-32b
PROFILE_DESC=Stable — Qwen3-32B (chat) + Qwen2.5-VL-7B (vision fallback)
PROFILE_TIER=production
