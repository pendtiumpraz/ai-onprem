#
# Profile: QWEN3.6-27B (Pilot / Next-Gen)
# ────────────────────────────────────────────────────────────────────────
# Stack: Qwen3.6-27B (chat + VLM in ONE model) + bge-m3 (embeddings) +
#        PaddleOCR + NGINX + Prometheus
#
# Use case: Pilot deployment untuk klien opt-in. Model baru (April 2026),
#           built-in vision = document analyzer + mapping jadi simpler.
#
# ⚠️  IMPORTANT BEFORE USING THIS PROFILE:
#   1. Verify vLLM version support hybrid DeltaNet architecture (update image kalau perlu)
#   2. AWQ quant mungkin belum tersedia — check HuggingFace Qwen org
#   3. Kalau AWQ belum ada, pakai FP16 — HANYA muat di H100 80GB
#   4. Test tool calling dengan hermes parser dulu di dev box
#
# Target GPU:
#   FP16 mode:  H100 80GB (54 GB weights + KV cache + VLM buffer)
#   AWQ Q4:     L40S 48GB atau H100 80GB (14 GB weights)
#

# No fallback VLM — built-in vision di model utama
COMPOSE_PROFILES=

# ==============================================================================
# Docker Images
# ==============================================================================
# NOTE: butuh vLLM version yang support Gated DeltaNet. Kalau v0.8.5 tidak jalan,
#       upgrade ke :latest atau pin version yang sudah merge PR support.
VLLM_IMAGE=vllm/vllm-openai:latest
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.5
OCR_IMAGE=paddlecloud/paddleocr-gpu:2.7.0

# ==============================================================================
# Directories
# ==============================================================================
MODELS_DIR=/opt/privasimu/models
TLS_DIR=/opt/privasimu/tls

# ==============================================================================
# GPU Assignment
# ==============================================================================
VLLM_GPU_ID=0
VLM_GPU_ID=0        # tidak dipakai (no VLM service aktif)
TEI_GPU_ID=0
OCR_GPU_ID=0

# ==============================================================================
# Primary LLM — Qwen3.6-27B (VLM built-in)
# ==============================================================================
LLM_MODEL_DIR=Qwen3.6-27B
LLM_SERVED_NAME=qwen3.6-27b
LLM_TP_SIZE=1

# Native 262k, tapi jangan full untuk KV cache safety. Adjust sesuai VRAM:
#   H100 80GB FP16: 65536 (64k) mulai, bisa sampai 131072 (128k)
#   L40S 48GB AWQ:  32768 (32k) comfortable
LLM_MAX_CONTEXT=65536

# H100 FP16: 0.85   |   L40S AWQ: 0.80
LLM_GPU_MEM_UTIL=0.85

# Leave blank untuk FP16 (butuh 54 GB, H100 only)
# Set "awq" kalau AWQ Q4 variant sudah tersedia (cek HF Qwen org)
LLM_QUANTIZATION=

# ==============================================================================
# VLM Fallback — DISABLED di profile ini (built-in di main model)
# ==============================================================================
VLM_MODEL_DIR=
VLM_SERVED_NAME=
VLM_GPU_MEM_UTIL=0
VLM_MAX_CONTEXT=0
VLM_QUANTIZATION=

# ==============================================================================
# Embedding
# ==============================================================================
EMBED_MODEL_DIR=bge-m3

# ==============================================================================
# OCR
# ==============================================================================
# OCR masih dipakai untuk quick-path (high-volume batch, light load di GPU).
# Heavy document analysis auto-dispatch ke main LLM via vision endpoint.
OCR_LANG=en

# ==============================================================================
# Gateway
# ==============================================================================
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
PROMETHEUS_PORT=9090
METRICS_RETENTION=30d

# ==============================================================================
# Profile metadata
# ==============================================================================
PROFILE_NAME=qwen3.6-27b
PROFILE_DESC=Pilot — Qwen3.6-27B with built-in VLM (document analyzer + mapping)
PROFILE_TIER=pilot
